{
  "name": "purelymail-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted management panel and webmail for PurelyMail",
  "scripts": {
    "dev": "node --run dev:server & node --run dev:web",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "node --run build:web && node --run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.6",
    "@hono/node-server": "^2.1.6",
    "fast-xml-parser": "^5.12.0",
    "hono": "^4.13.16",
    "ical.js": "^2.2.1",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@clerk/localizations": "^4.24.5",
    "@clerk/react": "^6.18.5",
    "@clerk/ui": "^1.42.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uqr": "^0.1.2",
    "vite": "^8.3.5"
  }
}
