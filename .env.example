# --- Required ---
# PurelyMail API key: https://purelymail.com/manage/account
PURELYMAIL_API_KEY=
# Clerk application keys: https://dashboard.clerk.com -> API keys
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Administrators: Clerk users whose verified primary email is listed (comma-separated)
ADMIN_EMAILS=you@example.com

# --- Recommended ---
# The public address of this site; Clerk tokens from other sites are refused
PUBLIC_URL=https://mail.example.com
# Clerk -> API keys -> JWT public key (PEM). Verifies sign-ins without a call to Clerk
# CLERK_JWT_KEY=

# --- Branding (optional) ---
# Name shown in the sidebar, on the sign-in page and in the browser tab
# BRAND_NAME=PurelyMail
# Logo: an https:// URL, or a file inside the data volume, e.g. /data/logo.svg (svg, png, webp, jpg, ico)
# BRAND_LOGO=/data/logo.svg

# --- Webmail (optional) ---
# Encrypts stored mailbox credentials and queued mail. If unset, a random key is
# created in DATA_DIR/secret.key on first start (keep it with your backups).
# SECRET_KEY=
# Save a copy of sent mail to the Sent folder (set false if your server already does)
# MAIL_SAVE_SENT=true
# Overrides for testing against another mail server
# MAIL_IMAP_HOST=imap.purelymail.com
# MAIL_IMAP_PORT=993
# MAIL_SMTP_HOST=smtp.purelymail.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_MAX_CONNECTIONS=40

# --- Advanced ---
# PORT=3000
# DATA_DIR=/data
# PURELYMAIL_API_URL=https://purelymail.com/api/v0
